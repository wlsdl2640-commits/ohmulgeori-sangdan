 "K": "#2a2420", "k": "#141014", "J": "#7a5232", "j": "#4e3420", "E": "#ffd040"}, "sh": [17, 9], "hip": 17, "ax": 12, "wpn": "hookpole", "arm": ["C", "c"], "hand": "S", "idle": {"h": [2, 3], "a": 70}, "act": {"atk": ["down", "side"], "skl": ["smash"], "tk": 1.15, "fx": {"atk": {"pal": "steel", "hit": "star"}, "skl": {"pal": "steel", "hit": "stun", "big": 1, "after": "sparks"}}}, "mon": {"base": "ratman"}, "label": "B 쇠 투구 간수", "desc": "통 쇠 투구(가로 틈 하나 · 노란 두 눈 · 리벳) · 가로로 누빈 붉은 겉옷 · 어깨에 비스듬히 건 쇠사슬 · 가죽 바지 · 끝이 휜 쇠 갈고리 장대", "field": "sewer", "area": "field", "show": [["down", 4], ["smash", 5]]}}, "extra": "// 갈고리 장대 (실험실 간수 B): 장대 끝에 휜 쇠 갈고리\nPXU_WPN.hookpole = (F, d) => { const [hx, hy] = pxsMHand(F), [dx, dy] = pxsDir(F.a || 0), px = -dy, py = dx, out = [], k = (d && d.ms) || 1, L = 6.0 * k, o = L - 6.0;\n  const at = (t, s, ch) => out.push([hx + 0.5 + dx * t + px * s, hy + 0.5 + dy * t + py * s, ch]);\n  for (let t = -2.5; t <= L; t += 0.5) at(t, 0, t < -2.5 + 0.6 ? 'g' : 'J');\n  for (const [t, s, ch] of [[10.5,-0.5,'M'],[10.5,0.5,'M'],[9.5,-1.5,'M'],[9.5,1.5,'M'],[8.5,1.5,'M'],[7.5,0.5,'M'],[7.5,1.5,'M'],[6.5,0.5,'M']]) for (const e of [-0.25, 0.25]) for (const f of [-0.25, 0.25]) at(t + o + e, s + f, ch);\n  return out; };\nPXU_FXW.hookpole = 'pole';\n"}