CCCCCCCCCCBBBBBBBBBB\n.............ccCCCCCCCCCCBBBBBBBBB\n.............csCCCCCCCCCCBBBBBBBBB\n.............sscbbbbbbbbbbbbbbbbbbb\n..............ssbbbnbnbbbbbbbbbbbbb\n...............scccncncUUBBBBBBBBBb\n.................uununuUUBBBBBBBBBb\n.................uununuUUBBPPBBBBBb\n.................uununuUUBBBBBBBBBb\n.................uNNNNNUUBBBBBBBBBb\n.................uNNNNNUUBBBBBBBBBb\n.................uuuuuuUUBBBBBBPPBb\n.................uuuuuu.UBBBBBBBBBb\n.................uuuuuu.UBBBBBBBBBb\n.................uuuuuu.UBBBBBBBBBb\n.................uuuuuu.UBBBBU\n.................uuuuu..UUUUUU\n.................uuuuu..UUUUUU\n.................uuuuu..UUUUUU\n.................uuuuu..UUUUUU\n.................bbbbbbbbbbbbbbbb\n................bbbbbbbbbbbbbbbbb\n................bbbbbbbbbbbbbbbbb\n................bbbbbbbbbbbbbbbbb\n", "pal": {"C": "#5e5a6a", "Q": "#827e90", "c": "#3e3a48", "U": "#4e4840", "u": "#36302a", "b": "#2a201a", "B": "#6e4a2e", "H": "#8a6e4a", "L": "#b09068", "h": "#5e4a30", "K": "#141210", "E": "#9af0ff", "M": "#9c968a", "m": "#5e5a50", "P": "#c8c0aa", "s": "#8a7a68", "N": "#a8b0b8", "n": "#5e6670", "x": "#f0f6ff", "o": "#6e4a26"}, "sh": [30, 18], "hip": 32, "ax": 24, "ms": 1.5, "wpn": "longchisel", "arm": ["C", "c"], "hand": "s", "idle": {"h": [3, 3], "a": -75}, "act": {"atk": ["pthrust", "plow"], "skl": ["pjump"], "tk": 1.25, "fx": {"atk": {"pal": "steel", "hit": "pierce", "big": 1}, "skl": {"pal": "earth", "hit": "quake", "big": 2, "after": "dust", "shake": 2}}}, "mon": {"base": "manhunter"}, "label": "B 돌 가면 석공", "desc": "B6 층 보스 · 미로의 돌로 깎은 가면을 쓴 석공 · 가면의 가로 눈 틈에 푸른 빛 둘 · 황토빛 두건 · 앞 어깨에 미로 마름돌 어깨받이 · 허리에 찬 정 둘 · 긴 쇠 끌을 창처럼 찌른다", "field": "passage", "area": "field", "show": [["pthrust", 4], ["pjump", 5]]}}, "extra": "// 돌 메 (미궁 석공 A): 자루 끝의 큰 네모 돌덩이 (큰 메)\nPXU_WPN.stonemallet = (F, d) => { const [hx, hy] = pxsMHand(F), [dx, dy] = pxsDir(F.a || 0), px = -dy, py = dx, out = [], k = (d && d.ms) || 1, L = 7.0 * k, o = L - 7.0;\n  const at = (t, s, ch) => out.push([hx + 0.5 + dx * t + px * s, hy + 0.5 + dy * t + py * s, ch]);\n  for (let t = -2.5; t <= L; t += 0.5) at(t, 0, t < -2.5 + 0.6 ? 'g' : 'o');\n  for (const [t, s, ch] of [[11.5,-3.0,'N'],[11.5,-2.0,'N'],[11.5,-1.0,'N'],[11.5,0.0,'N'],[11.5,1.0,'N'],[11.5,2.0,'N'],[11.5,3.0,'N'],[10.5,-3.0,'N'],[10.5,-2.0,'N'],[10.5,-1.0,'N'],[10.5,0.0,'N'],[10.5,1.0,'N'],[10.5,2.0,'N'],[10.5,3.0,'N'],[9.5,-3.0,'N'],[9.5,-2.0,'N'],[9.5,-1.0,'N'],[9.5,0.0,'N'],[9.5,1.0,'N'],[9.5,2.0,'N'],[9.5,3.0,'N'],[8.5,-3.0,'N'],[8.5,-2.0,'N'],[8.5,-1.0,'N'],[8.5,0.0,'N'],[8.5,1.0,'N'],[8.5,2.0,'N'],[8.5,3.0,'N'],[7.5,-3.0,'n'],[7.5,-2.0,'n'],[7.5,-1.0,'n'],[7.5,0.0,'n'],[7.5,1.0,'n'],[7.5,2.0,'n'],[7.5,3.0,'n']]) for (const e of [-0.25, 0.25]) for (const f of [-0.25, 0.25]) at(t + o + e, s + f, ch);\n  return out; };\nPXU_FXW.stonemallet = 'club';\n// 긴 쇠 끌 (미궁 석공 B): 끝이 납작한 날인 긴 쇠 끌을 창처럼\nPXU_WPN.longchisel = (F, d) => { const [hx, hy] = pxsMHand(F), [dx, dy] = pxsDir(F.a || 0), px = -dy, py = dx, out = [], k = (d && d.ms) || 1, L = 8.0 * k, o = L - 8.0;\n  const at = (t, s, ch) => out.push([hx + 0.5 + dx * t + px * s, hy + 0.5 + dy * t + py * s, ch]);\n  for (let t = -3.0; t <= L; t += 0.5) at(t, 0, t < -3.0 + 0.6 ? 'g' : 'n');\n  for (const [t, s, ch] of [[13.5,0.0,'x'],[12.5,-1.0,'N'],[12.5,0.0,'N'],[12.5,1.0,'N'],[11.5,-1.0,'N'],[11.5,0.0,'N'],[11.5,1.0,'N'],[10.5,-1.0,'N'],[10.5,0.0,'N'],[10.5,1.0,'N'],[9.5,-1.0,'n'],[9.5,0.0,'N'],[9.5,1.0,'n'],[8.5,0.0,'n']]) for (const e of [-0.25, 0.25]) for (const f of [-0.25, 0.25]) at(t + o + e, s + f, ch);\n  return out; };\nPXU_FXW.longchisel = 'lance';\n"}