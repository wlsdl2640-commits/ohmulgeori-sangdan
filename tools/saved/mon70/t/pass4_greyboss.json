N": "#a08850", "b": "#3a2a20", "n": "#565c64", "k": "#140c0c", "P": "#3a3a40", "K": "#1a1418", "V": "#b8b4ac", "v": "#8a867e"}, "sh": [33, 16], "hip": 32, "ax": 24, "ms": 1.5, "mx": 20, "my": 20, "wpn": "lanternst", "arm": ["C", "c"], "hand": "S", "idle": {"h": [1, 4], "a": -72}, "act": {"atk": ["spush", "sjab"], "mag": ["sraise"], "skl": ["scharge"], "tk": 1.2, "fx": {"atk": {"pal": "coin", "hit": "star", "big": 1}, "mag": {"pal": "coin", "hit": "coins", "p": "orb"}, "skl": {"pal": "coin", "hit": "coins", "big": 2, "after": "sparks", "aoe": "meteor", "shake": 2}}}, "mon": {"base": "officer"}, "label": "A 장부지기", "desc": "잿빛 장부 두목 · 벗어진 머리와 흰 구레나룻 · 둥근 안경 · 털 깃 단 잿빛 긴 외투와 금단추 · 먼 손목에 사슬로 맨 큰 잿빛 장부(놋쇠 모서리 · 잠금쇠) · 놋쇠 등불 지팡이로 찌르고 금화를 쏟아붓는다", "field": "sewer", "area": "dungeon", "show": [["sjab", 4], ["scharge", 6]]}, "greyledger_b": {"g": "\n......................NNNNNNNN\n.....................xxxxxxxxxx\n....................NNNNNNNNNNNN\n....................NNNNNNNNNNNN\n....................NNNNNNNNNNNN\n....................NNNNNNkkeeek\n....................NNNNNNkkeeek\n.....................NNNNNNNNNN\n....nnnnnnnnnnn......SSSSSSSSSSSS\n....nxNNNNNNNxn......SSSSSSSSSSSS\n....nNNNNNNNNNn......SSSSssssssSS\n....nNNNNNNNNNn......SSSSssssss\n....nNNNNNNNNNn......SSSSssssss\n....nNNNNNNNNNnQQQQQQQSSSsssssQQQQQ\n....nnnnnnnnncQCCCCCCCCCCCCCCCCCCNCQ\n....nNNNNNNccQCCCCCCCCCCCCCCCCCCnCCC\n....nNNGGGNccCCCCCCCCCCCCCCCCCCNCCCC\n....nNNGGGcccCCCCCCCCCCCCCCCCCnCCCCC\n....nNNGGGcccCCCCCCCCCCCCCCCCNCCCCCC\n....nNNGGccccCccccccccccccccnccccccc\n....nNNNNccccCCCCCCCCCCCCCNCCCCCCCCC\n....nNNNNccccCCCCCCCCCCCCnCCCCCCCCCC\n....nnnncccccCCCCCCCCCCCNCCCCCCCCCCC\n....nNNNcccccCCCCCCCCCCnCCCCCCCCCCCC\n....nNNNcccccCccccccccNccccccccccccc\n....nNNNcccccCCCCCCCCnCCCCCCCCCCCCCC\n....nNNNcccccCCCCCCCNCCCCCCCCCCCCCCC\n....nxNNcccccCCCCCCnCCCCCCCCCCCCCCCC\n....nnnncccccCCCCCNCCCCCCCCCCCCCCCCC\n........SSSSSCccnccccccccccccccccccc\n.......SSSSSSCCCCCCCCCCCCCCCCCCCCCCC\n.......SSSSSSbbbbbbbbbbbbbbbbbbbbbbbb\n.......SSSSSSbbbbbbbbbbbbbbbbbbbbbbbb\n.......SSSSSSbbbbbbbbbbbbbbbbbbbbbbbb\n.......SSSSSSbbbbbbbbbbbbbbbbbbbbbbbb\n.......SSSSSSSScccccccccccccccccccc\n................ppppppp..PPPPPPP\n................ppppppp..PPPPPPP\n................ppppppp..PPPPPPP\n................ppppppp..PPPPPPP\n................ppppppp..PPPPPPP\n................ppppppp..PPPPPPP\n................ppppppp..PPPPPPP\n................ppppppp..PPPPPPP\n................ppppppp..PPPPPPP\n...............KKKKKKKKKKKKKKKKKKKKK\n...............KKKKKKKKKKKKKKKKKKKKK\n...............KKKKKKKKKKKKKKKKKKKKK\n...............KKKKKKKKKKKKKKKKKKKKK\n", "pal": {"C": "#5a5a60", "c": "#3a3a40", "Q": "#7a7a82", "S": "#c89a78", "s": "#9a6e52", "N": "#6a6e76", "n": "#3e424a", "x": "#9aa0aa", "e": "#ffd040", "k": "#140c0c", "b": "#3a2a20", "P": "#34343a", "K": "#1a1418", "G": "#d8b040"}, "sh": [34, 18], "hip": 33, "ax": 24, "ms": 1.5, "mx": 20, "my": 20, "wpn": "bighook", "arm": ["C", "c"], "hand": "S", "idle": {"h": [1, 4], "a": 70}, "act": {"atk": ["side", "down"], "skl": ["smash"], "tk": 1.3, "fx": {"atk": {"pal": "steel", "hit": "star", "big": 2}, "skl": {"pal": "steel", "hit": "quake", "big": 2, "after": "dust", "aoe": "slam", "shake": 4}}}, "mon": {"base": "officer"}, "label": "B 금고지기", "desc": "잿빛 장부 두목 · 쇠 반투구의 가로 눈 틈에 노란 눈빛 · 덩치 큰 잿빛 누빈 외투 · 등에 사슬로 진 쇠 금고(자물쇠 · 리벳) · 큰 짐 갈고리로 걸어 내리찍는다", "field": "sewer", "area": "dungeon", "show": [["side", 4], ["smash", 5]]}}, "extra": "// 등불 지팡이 (장부지기): 긴 지팡이 끝에 매단 놋쇠 등불\nPXU_WPN.lanternst = (F, d) => { const [hx, hy] = pxsMHand(F), [dx, dy] = pxsDir(F.a || 0), px = -dy, py = dx, out = [], k = (d && d.ms) || 1, L = 8.0 * k, o = L - 8.0;\n  const at = (t, s, ch) => out.push([hx + 0.5 + dx * t + px * s, hy + 0.5 + dy * t + py * s, ch]);\n  for (let t = -4.0; t <= L; t += 0.5) at(t, 0, t < -4.0 + 0.6 ? 'g' : 'b');\n  for (const [t, s, ch] of [[12.5,-1.0,'N'],[12.5,0.0,'N'],[12.5,1.0,'N'],[11.5,-1.0,'N'],[11.5,0.0,'Y'],[11.5,1.0,'N'],[10.5,-1.0,'N'],[10.5,0.0,'Y'],[10.5,1.0,'N'],[9.5,-1.0,'N'],[9.5,0.0,'N'],[9.5,1.0,'N'],[8.5,0.0,'N']]) for (const e of [-0.25, 0.25]) for (const f of [-0.25, 0.25]) at(t + o + e, s + f, ch);\n  return out; };\nPXU_FXW.lanternst = 'staff';\n// 큰 짐 갈고리 (금고지기): 긴 자루 끝의 큰 쇠갈고리\nPXU_WPN.bighook = (F, d) => { const [hx, hy] = pxsMHand(F), [dx, dy] = pxsDir(F.a || 0), px = -dy, py = dx, out = [], k = (d && d.ms) || 1, L = 6.5 * k, o = L - 6.5;\n  const at = (t, s, ch) => out.push([hx + 0.5 + dx * t + px * s, hy + 0.5 + dy * t + py * s, ch]);\n  for (let t = -3.0; t <= L; t += 0.5) at(t, 0, t < -3.0 + 0.6 ? 'g' : 'b');\n  for (const [t, s, ch] of [[11.0,-1.5,'N'],[11.0,-0.5,'N'],[10.0,0.5,'N'],[9.0,0.5,'N'],[8.0,0.5,'N'],[7.0,-0.5,'N'],[7.0,0.5,'N']]) for (const e of [-0.25, 0.25]) for (const f of [-0.25, 0.25]) at(t + o + e, s + f, ch);\n  return out; };\nPXU_FXW.bighook = 'axe';\n"}