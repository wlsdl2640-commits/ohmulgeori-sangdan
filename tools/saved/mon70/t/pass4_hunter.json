.......BBBBBBBBBBB\n..........CCCCCCCCCnC\n..........ccccccccccN\n...........pppp.PPP\n...........pppp.PPP\n...........pppp.PPP\n...........pppp.PPP\n...........pppp.PPP\n...........pppp.PPP\n...........pppp.PPP\n...........KKKKKKKKKK\n...........KKKKKKKKKK\n...........KKKKKKKKKK\n", "pal": {"S": "#c89070", "s": "#9a6a4e", "k": "#1a1210", "R": "#b02a2a", "r": "#701a1a", "Y": "#7a6a58", "y": "#54483c", "C": "#4a3a30", "c": "#30261e", "N": "#8a9098", "n": "#565c64", "B": "#2e2420", "P": "#3e3630", "p": "#2a2420", "K": "#1a1418", "b": "#3a2a20"}, "sh": [18, 9], "hip": 18, "ax": 15, "ms": 1.0, "wpn": "shackle", "arm": ["S", "R"], "hand": "R", "idle": {"h": [2, 2], "a": 40}, "act": {"atk": ["down", "side"], "skl": ["smash"], "tk": 1.05, "fx": {"atk": {"pal": "blood", "hit": "star"}, "skl": {"pal": "blood", "hit": "stun", "big": 1, "after": "dust"}}}, "mon": {"base": "enforcer"}, "label": "B 사슬잡이", "desc": "붉은 손 형제단의 사람 사냥꾼 · 민머리 · 얼굴에 그은 붉은 줄 둘 · 짧은 턱수염 · 털 어깨 덮개 · 몸에 비스듬히 감은 사슬 · 붉게 물든 팔 · 족쇄 달린 사슬을 휘두른다", "field": "sewer", "area": "field", "show": [["side", 4], ["smash", 5]]}}, "extra": "// 쇠공 사슬 (사람 사냥꾼 B): 사슬 끝의 무거운 쇠공 (가시 없음)\nPXU_WPN.ironball = (F, d) => { const [hx, hy] = pxsMHand(F), [dx, dy] = pxsDir(F.a || 0), px = -dy, py = dx, out = [], k = (d && d.ms) || 1, L = 5.5 * k, o = L - 5.5;\n  const at = (t, s, ch) => out.push([hx + 0.5 + dx * t + px * s, hy + 0.5 + dy * t + py * s, ch]);\n  for (let t = -1.0; t <= L; t += 0.5) at(t, 0, t < -1.0 + 0.6 ? 'g' : 'n');\n  for (const [t, s, ch] of [[10.0,-1.0,'N'],[10.0,0.0,'N'],[10.0,1.0,'N'],[9.0,-2.0,'N'],[9.0,-1.0,'x'],[9.0,0.0,'N'],[9.0,1.0,'N'],[9.0,2.0,'N'],[8.0,-2.0,'N'],[8.0,-1.0,'N'],[8.0,0.0,'N'],[8.0,1.0,'N'],[8.0,2.0,'n'],[7.0,-2.0,'N'],[7.0,-1.0,'N'],[7.0,0.0,'N'],[7.0,1.0,'n'],[7.0,2.0,'n'],[6.0,-1.0,'n'],[6.0,0.0,'n'],[6.0,1.0,'n']]) for (const e of [-0.25, 0.25]) for (const f of [-0.25, 0.25]) at(t + o + e, s + f, ch);\n  return out; };\nPXU_FXW.ironball = 'club';\n// 가죽 곤봉 (사람 사냥꾼 A): 모래를 채운 굵은 가죽 곤봉\nPXU_WPN.sap = (F, d) => { const [hx, hy] = pxsMHand(F), [dx, dy] = pxsDir(F.a || 0), px = -dy, py = dx, out = [], k = (d && d.ms) || 1, L = 3.5 * k, o = L - 3.5;\n  const at = (t, s, ch) => out.push([hx + 0.5 + dx * t + px * s, hy + 0.5 + dy * t + py * s, ch]);\n  for (let t = -1.0; t <= L; t += 0.5) at(t, 0, t < -1.0 + 0.6 ? 'g' : 'j');\n  for (const [t, s, ch] of [[7.0,-0.5,'J'],[7.0,0.5,'J'],[6.0,-0.5,'J'],[6.0,0.5,'J'],[5.0,-0.5,'J'],[5.0,0.5,'j'],[4.0,-0.5,'j'],[4.0,0.5,'j']]) for (const e of [-0.25, 0.25]) for (const f of [-0.25, 0.25]) at(t + o + e, s + f, ch);\n  return out; };\nPXU_FXW.sap = 'club';\n"}