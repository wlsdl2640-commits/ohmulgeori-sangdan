x = -dy, py = dx, out = [], k = (d && d.ms) || 1, L = 7.0 * k, o = L - 7.0;\n  const at = (t, s, ch) => out.push([hx + 0.5 + dx * t + px * s, hy + 0.5 + dy * t + py * s, ch]);\n  for (let t = -2.5; t <= L; t += 0.5) at(t, 0, t < -2.5 + 0.6 ? 'g' : 'J');\n  for (const [t, s, ch] of [[13.5,0.0,'P'],[12.5,-1.0,'P'],[12.5,0.0,'o'],[12.5,1.0,'P'],[11.5,-1.0,'P'],[11.5,0.0,'o'],[11.5,1.0,'P'],[10.5,-2.0,'P'],[10.5,-1.0,'P'],[10.5,0.0,'o'],[10.5,1.0,'P'],[10.5,2.0,'P'],[9.5,-1.0,'P'],[9.5,0.0,'P'],[9.5,1.0,'P'],[8.5,0.0,'g'],[7.5,-1.0,'g'],[7.5,0.0,'g'],[7.5,1.0,'g']]) for (const e of [-0.25, 0.25]) for (const f of [-0.25, 0.25]) at(t + o + e, s + f, ch);\n  return out; };\nPXU_FXW.vscep = 'staff';\n// 보랏빛 수정 창 (타락한 대천사 B): 빛바랜 금 받침 위 길쭉한 보랏빛 수정 날\nPXU_WPN.dspear = (F, d) => { const [hx, hy] = pxsMHand(F), [dx, dy] = pxsDir(F.a || 0), px = -dy, py = dx, out = [], k = (d && d.ms) || 1, L = 7.0 * k, o = L - 7.0;\n  const at = (t, s, ch) => out.push([hx + 0.5 + dx * t + px * s, hy + 0.5 + dy * t + py * s, ch]);\n  for (let t = -2.5; t <= L; t += 0.5) at(t, 0, t < -2.5 + 0.6 ? 'g' : 'J');\n  for (const [t, s, ch] of [[14.5,0.0,'p'],[13.5,0.0,'P'],[12.5,-1.0,'P'],[12.5,0.0,'o'],[12.5,1.0,'P'],[11.5,-1.0,'P'],[11.5,0.0,'o'],[11.5,1.0,'P'],[10.5,-1.0,'P'],[10.5,0.0,'P'],[10.5,1.0,'P'],[9.5,-1.0,'P'],[9.5,0.0,'P'],[8.5,-2.0,'g'],[8.5,-1.0,'g'],[8.5,1.0,'g'],[8.5,2.0,'g'],[7.5,-1.0,'g'],[7.5,0.0,'g'],[7.5,1.0,'g']]) for (const e of [-0.25, 0.25]) for (const f of [-0.25, 0.25]) at(t + o + e, s + f, ch);\n  return out; };\nPXU_FXW.dspear = 'staff';\n"}