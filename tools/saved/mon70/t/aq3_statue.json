{"defs": {"aqsentinel": {"g": "\n...............QQ\n.............PQCCQPQ\n.............PCCCCPC\n............QPCCCCPC\n............ddddddddd\n...........QCCCccQQQ\n...........ccccccQEE\n...............ccQQQc\n...............ccQdd\n...........QQQQccQQQQ\n..........QCCCCQQQQQQ\n..........CPCCCMMMMMMmm\n..........cPcccMPPPPppm\n..........CPCCCMPpPPppm\n..........cPcccMPpPPppm\n..........CPCCCMPpPPppm\n..........cccccMPPPPppm\n..........CCCCCMPMMMppm\n..........CCCCCMPMQMppm\n..........CCCCCMPMMMppm\n..........CCCCCMPPMmppm\n.........QCCCCCMPPPPppm\n.........cccPccMPPPPppm\n...........cPc.MPPPPppm\n...........cPc.MPPPPppm\n...........cPc.MPPPPppm\n...........cPc.MMMMMMmm\n...........ccc..CCCC\n...........cccccCCCCQ\n..........sccccccccccT\n..........sssssSSSSSS\n", "pal": {"C": "#9a7e4a", "Q": "#c8a868", "c": "#6a5430", "d": "#46381e", "P": "#5aa890", "p": "#3a7a66", "M": "#d8b45a", "m": "#a8823a", "S": "#8a8478", "s": "#5e5a52", "T": "#b4ae9e", "E": "#7af0ff", "k": "#141210"}, "sh": [20, 11], "hip": 21, "ax": 15, "ms": 1.25, "wpn": "aqspear", "arm": ["C", "c"], "hand": "C", "idle": {"h": [2, 2], "a": -75}, "act": {"atk": ["thrust", "side"], "skl": ["smash"], "tk": 1.2, "fx": {"atk": {"pal": "earth", "hit": "star", "big": 1}, "skl": {"pal": "water", "hit": "stun", "big": 1, "after": "bubbles", "shake": 2}}}, "mon": {"base": "ruinguard"}, "label": "A 녹청 청동 병사상", "desc": "옛 제국 병사의 청동상 · 꼭지 하나 달린 둥근 투구(볏 없음)와 뒤로 벌어진 목가리개 · 빈 눈에 남은 희미한 하늘빛 · 앞으로 든 긴 방패(가운데 둥근 돌기) · 띠 갑옷 · 흘러내린 녹청 줄 · 발에 붙은 깨진 받침돌 · 긴 창으로 찌른다", "field": "sewer", "area": "field", "show": [["thrust", 4], ["smash", 5]]}, "aqsentinel_b": {"g": "\n....TVVVVTTTTTTTTTTTTTTT\n....SSSSSSsSSSSSSSSSSSSSs\n....SSSSSSssSSSSSSSSSSSSss\n......sssssssssssssssssss\n.......Ssssssssssssssss.s\n........ssssssssssssss\n.......ccc.....QCCCCCQ\n.......ccc.....CCCdddC\n.......ccc.....CCCCEEC\n.......ccc.....Ccccccc\n.......cccc....Ccccccc\n........ccc....Ccdccdc\n........ccQQQQQCcccdcc\n.........QCCCCCCcccccc\n.........CCCCCCCCCCCCC