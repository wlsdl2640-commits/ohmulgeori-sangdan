...cccccccccQQcMQQE......eQQQQcMQcc\n.....cccccccccCCcMCCE......eCCCCcMCcc\n.....ccccccccccccMccE......ecccccMNNc\n.....cccccccccMMMMMME......eMMMMMMNNc\n.....cccccccccQQQQQQE......ecMQQQQQcc\n.....cccccccccCCCCCCE......ecMCCCCCcc\n.....cccccccccccccceE......EeMccccccc\n.....cccccccccMMMMME........eMMMMNNNc\n.....cccccccccQQcMQE........eQQQcMQcc\n............CCCCcMCE........eCCCcMCcc\n............CccccMceeeeeeeeeeccccMccc\n............cMMMMMMMMMMMMMMMMMMMMMMMc\n............cMQQQQQQcMQQQQQQcMQQQQQcc\n............cMcccccccMcccCCCcMCCccccc\n.............ccccccccccccCCCCQCccccc\n...............ccccccc...CCCCCcc\n...............ccccccc...CCCCCcc\n...............ccccccc...CCCCCcc\n...............ccccccc...CCCCCcc\n...............ccccccc...CCCCCcc\n...............ccccccc...CCCCCcc\n...............ccccccc...CCCCCcc\n...............ccccccc...CCCCCcc\n...............ccccccc...CCCCCcc\n...............ccccccc...ccccccc\n...............ccccccc...ccccccc\n..............ddddddddd.ccccccccc\n..............ddddddddd.ccccccccc\n..............ddddddddd.ccccccccc\n..............ddddddddd.ccccccccc\n", "pal": {"C": "#8a8476", "Q": "#b2ac9a", "c": "#5e5a50", "d": "#3a3832", "M": "#4c4842", "K": "#141210", "E": "#ffd080", "e": "#c88a3a", "N": "#6a6e74", "n": "#3e4248", "x": "#9aa0a6", "G": "#c8a050", "g": "#8a6a30", "R": "#d8c080", "D": "#6a5e4c", "o": "#4a4034"}, "sh": [33, 17], "hip": 39, "ax": 27, "ms": 1.5, "wpn": "giantkey", "arm": ["C", "c"], "hand": "C", "idle": {"h": [3, 3], "a": -60}, "act": {"atk": ["down", "side"], "skl": ["smash"], "tk": 1.35, "fx": {"atk": {"pal": "earth", "hit": "star", "big": 1}, "skl": {"pal": "gold", "hit": "quake", "big": 2, "after": "dust", "aoe": "rocks", "shake": 3}}}, "mon": {"base": "golem"}, "label": "B 열쇠 구멍 문지기", "desc": "B9 층 보스(돌 미로의 무대 주인) · 몸통을 꿰뚫은 큰 열쇠 구멍(뒤가 보인다 · 둘레가 누렇게 빛난다) · 성가퀴 얹은 성문 탑 머리 · 몸에 걸친 쇠사슬 · 칼처럼 쥔 큰 열쇠로 내리친다 · 미로의 돌이 쏟아진다", "field": "passage", "area": "field", "show": [["down", 4], ["smash", 5]]}}, "extra": "// 열쇠 미늘창 (미궁 문지기 A): 창대 끝이 큰 열쇠 — 둥근 손잡이 고리와 한쪽으로 난 열쇠 이\nPXU_WPN.keyhalberd = (F, d) => { const [hx, hy] = pxsMHand(F), [dx, dy] = pxsDir(F.a || 0), px = -dy, py = dx, out = [], k = (d && d.ms) || 1, L = 8.0 * k, o = L - 8.0;\n  const at = (t, s, ch) => out.push([hx + 0.5 + dx * t + px * s, hy + 0.5 + dy * t + py * s, ch]);\n  for (let t = -3.5; t <= L; t += 0.5) at(t, 0, t < -3.5 + 0.6 ? 'g' : 'n');\n  for (const [t, s, ch] of [[15.5,-1.0,'G'],[15.5,0.0,'G'],[15.5,1.0,'G'],[14.5,-1.0,'G'],[14.5,1.0,'G'],[13.5,-1.0,'G'],[13.5,0.0,'G'],[13.5,1.0,'G'],[12.5,0.0,'G'],[11.5,0.0,'G'],[11.5,1.0,'G'],[11.5,2.0,'G'],[10.5,0.0,'G'],[9.5,0.0,'G'],[9.5,1.0,'G'],[8.5,0.0,'G']]) for (const e of [-0.25, 0.25]) for (const f of [-0.25, 0.25]) at(t + o + e, s + f, ch);\n  return out; };\nPXU_FXW.keyhalberd = 'lance';\n// 큰 열쇠 칼 (미궁 문지기 B): 칼처럼 쥔 큰 놋쇠 열쇠 — 끝에 한쪽으로 난 열쇠 이\nPXU_WPN.giantkey = (F, d) => { const [hx, hy] = pxsMHand(F), [dx, dy] = pxsDir(F.a || 0), px = -dy, py = dx, out = [], k = (d && d.ms) || 1, L = 6.5 * k, o = L - 6.5;\n  const at = (t, s, ch) => out.push([hx + 0.5 + dx * t + px * s, hy + 0.5 + dy * t + py * s, ch]);\n  for (let t = -2.5; t <= L; t += 0.5) at(t, 0, t < -2.5 + 0.6 ? 'g' : 'G');\n  for (const [t, s, ch] of [[12.0,0.0,'G'],[12.0,1.0,'G'],[11.0,0.0,'G'],[10.0,0.0,'G'],[10.0,1.0,'G'],[10.0,2.0,'G'],[9.0,0.0,'G'],[8.0,0.0,'G'],[7.0,0.0,'G']]) for (const e of [-0.25, 0.25]) for (const f of [-0.25, 0.25]) at(t + o + e, s + f, ch);\n  return out; };\nPXU_FXW.giantkey = 'club';\n"}