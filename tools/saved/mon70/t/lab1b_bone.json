' : 'o');\n  for (const [t, s, ch] of [[12.5,-1.0,'N'],[12.5,0.0,'N'],[12.5,1.0,'N'],[11.5,-2.0,'N'],[11.5,-1.0,'N'],[11.5,0.0,'N'],[11.5,1.0,'N'],[11.5,2.0,'N'],[10.5,-2.0,'N'],[10.5,-1.0,'N'],[10.5,0.0,'N'],[10.5,1.0,'N'],[10.5,2.0,'N'],[9.5,-2.0,'N'],[9.5,-1.0,'N'],[9.5,0.0,'N'],[9.5,1.0,'N'],[9.5,2.0,'N'],[8.5,-1.0,'N'],[8.5,0.0,'N'],[8.5,1.0,'N'],[7.5,0.0,'n']]) for (const e of [-0.25, 0.25]) for (const f of [-0.25, 0.25]) at(t + o + e, s + f, ch);\n  return out; };\nPXU_FXW.graveshovel = 'club';\n// 넓적다리뼈 몽둥이 (뼈 무덤지기 B): 끝이 두 혹으로 갈린 큰 뼈\nPXU_WPN.boneclub = (F, d) => { const [hx, hy] = pxsMHand(F), [dx, dy] = pxsDir(F.a || 0), px = -dy, py = dx, out = [], k = (d && d.ms) || 1, L = 6.0 * k, o = L - 6.0;\n  const at = (t, s, ch) => out.push([hx + 0.5 + dx * t + px * s, hy + 0.5 + dy * t + py * s, ch]);\n  for (let t = -2.0; t <= L; t += 0.5) at(t, 0, t < -2.0 + 0.6 ? 'g' : 'P');\n  for (const [t, s, ch] of [[9.5,-2.0,'P'],[9.5,-1.0,'P'],[9.5,1.0,'P'],[9.5,2.0,'P'],[8.5,-2.0,'P'],[8.5,-1.0,'P'],[8.5,0.0,'P'],[8.5,1.0,'P'],[8.5,2.0,'P'],[7.5,-1.0,'P'],[7.5,0.0,'P'],[7.5,1.0,'P'],[6.5,0.0,'P']]) for (const e of [-0.25, 0.25]) for (const f of [-0.25, 0.25]) at(t + o + e, s + f, ch);\n  return out; };\nPXU_FXW.boneclub = 'club';\n"}