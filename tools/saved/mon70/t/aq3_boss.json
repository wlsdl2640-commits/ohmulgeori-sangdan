(입에서 앞으로 휘어 떨어지는 물) · 금 테 어깨받이 · 낡은 남빛 망토 · 바깥 갈래가 휜 청동 삼지창", "field": "sewer", "area": "dungeon", "show": [["side", 4], ["smash", 5]]}}, "extra": "// 청동 삼지창 (청동 수문장): 바깥 두 갈래가 휘어 벌어진 세 갈래 날\nPXU_WPN.aqtrident = (F, d) => { const [hx, hy] = pxsMHand(F), [dx, dy] = pxsDir(F.a || 0), px = -dy, py = dx, out = [], k = (d && d.ms) || 1, L = 8.0 * k, o = L - 8.0;\n  const at = (t, s, ch) => out.push([hx + 0.5 + dx * t + px * s, hy + 0.5 + dy * t + py * s, ch]);\n  for (let t = -4.0; t <= L; t += 0.5) at(t, 0, t < -4.0 + 0.6 ? 'g' : 'c');\n  for (const [t, s, ch] of [[12.5,-2.0,'Q'],[12.5,2.0,'M'],[11.5,-2.0,'M'],[11.5,0.0,'Q'],[11.5,2.0,'m'],[10.5,-2.0,'M'],[10.5,0.0,'M'],[10.5,2.0,'m'],[9.5,-1.0,'M'],[9.5,0.0,'M'],[9.5,1.0,'m'],[8.5,0.0,'m']]) for (const e of [-0.25, 0.25]) for (const f of [-0.25, 0.25]) at(t + o + e, s + f, ch);\n  return out; };\nPXU_FXW.aqtrident = 'trident';\n"}